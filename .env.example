# Copy this file to .env and fill in real values. Never commit .env.

# Get this free at https://build.nvidia.com -> sign in -> click any model -> "Get API Key"
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any random string - this is the local key Claude Code will use to authenticate
# to the LiteLLM proxy running on your own machine. Not sent to NVIDIA or Anthropic.
LITELLM_MASTER_KEY=sk-local-choose-your-own-string
